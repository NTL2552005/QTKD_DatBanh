DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_PASSWORD=choose-a-strong-demo-password
WORKFLOW_ENABLED=False
WORKFLOW_WEBHOOK_URL=
WORKFLOW_WEBHOOK_TOKEN=
WORKFLOW_TIMEOUT_SECONDS=5
SITE_BASE_URL=http://127.0.0.1:8000
AI_ENABLED=False
# Gemini is the default provider. Keep the key blank in this example.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Legacy OpenAI settings are used only when AI_PROVIDER=openai.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=800
AI_MIN_CONFIDENCE=0.55
AI_USER_REQUESTS_PER_MINUTE=6
AI_GLOBAL_REQUESTS_PER_MINUTE=60
